# CareHub — Next.js app environment variables
# Copy this file to .env.local and fill in real values from your own
# Supabase project and Clerk application. Never commit .env.local.

# Supabase (Project Settings -> API) — the anon key is safe for the
# client; access is scoped per-user by Postgres RLS policies keyed off
# the Clerk session, not by this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clerk (Configure -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Not set here ---
# The `send-reminders` Supabase Edge Function (supabase/functions/) runs
# in its own Deno runtime, separate from this Next.js app, and reads its
# own secrets: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY,
# RESEND_FROM_EMAIL, and CRON_SECRET. Set those with
# `supabase secrets set <NAME>=<value>`, not in this file.
